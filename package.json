{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && vite build --ssr",
        "format": "prettier --write .",
        "release": "export GITHUB_TOKEN=$(cat .github_token) && release-it",
        "preview": "tsc && npm run build && php artisan inertia:start-ssr"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@inertiajs/react": "^1.3.0",
        "@release-it/bumper": "^6.0.1",
        "@release-it/conventional-changelog": "^8.0.2",
        "@tailwindcss/forms": "^0.5.11",
        "@types/node": "^18.19.130",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.5.0",
        "axios": "^1.15.2",
        "laravel-vite-plugin": "^1.3.0",
        "postcss": "^8.5.13",
        "prettier": "^3.8.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "release-it": "^17.11.0",
        "shadcn": "^3.8.5",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^5.4.21",
        "vite-plugin-watch": "^0.3.1"
    },
    "dependencies": {
        "@uiw/react-md-editor": "^4.1.0",
        "caniuse-lite": "^1.0.30001791",
        "clsx": "^2.1.1",
        "framer-motion": "^11.18.2",
        "justd-icons": "^1.10.27",
        "markdown-it": "^14.1.1",
        "react-aria-components": "^1.17.0",
        "react-markdown": "^9.1.0",
        "react-markdown-editor-lite": "^1.4.2",
        "react-syntax-highlighter": "^15.6.6",
        "rehype-highlight": "^7.0.2",
        "rehype-raw": "^7.0.0",
        "remark-gfm": "^4.0.1",
        "sonner": "^1.7.4",
        "tailwind-merge": "^2.6.1",
        "tailwind-variants": "^0.2.1",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^1.2.0"
    },
    "release-it": {
        "git": {
            "commitMessage": "chore: release v${version}"
        },
        "github": {
            "release": true
        },
        "plugins": {
            "@release-it/conventional-changelog": {
                "infile": "CHANGELOG.md",
                "preset": {
                    "name": "conventionalcommits",
                    "types": [
                        {
                            "type": "feat",
                            "section": "Features"
                        },
                        {
                            "type": "fix",
                            "section": "Bug Fixes"
                        },
                        {
                            "type": "chore",
                            "section": "Chores"
                        }
                    ]
                }
            },
            "@release-it/bumper": {
                "in": "composer.json",
                "out": "composer.json"
            }
        }
    },
    "version": "1.0.22"
}
